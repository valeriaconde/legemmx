---
import Base from '@/layouts/Base.astro';
import CallToAction from '@/components/CallToAction.astro';
import PublicationRow from '@/components/PublicationRow.astro';
import { render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { useTranslations } from '@/i18n/ui';
import { publicationPath, type Lang } from '@/i18n/routes';
import { formatDate, getPublications, getTranslationUrl, type Publication } from '@/lib/publications';

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
const { lang, category } = pub;
const t = useTranslations(lang);
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altPath = (await getTranslationUrl(pub, altLang)) ?? publicationPath(category, altLang);
const { title, summary, date, pdf: pdfPath, author } = pub.entry.data;
// Solo se muestra el PDF si el archivo realmente existe en /public (evita enlaces rotos).
const pdf = pdfPath && existsSync(join(process.cwd(), 'public', pdfPath)) ? pdfPath : '';
const { Content } = await render(pub.entry);
const hasBody = Boolean(pub.entry.body?.trim());
const related = (await getPublications(category, lang)).filter((p) => p.slug !== pub.slug).slice(0, 3);
---

<Base lang={lang} title={title} description={summary} altPath={altPath}>
  <article>
    <header class="container-x pt-36 pb-12 md:pt-44 md:pb-16">
      <nav class="mono flex flex-wrap items-center gap-2 text-muted" aria-label="Breadcrumb" data-hero-item>
        <a href={publicationPath(category, lang)} class="link-line">← {t(`pubs.${category}` as const)}</a>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        {author && <span>· {author}</span>}
      </nav>
      <h1 class="display-lg mt-8 max-w-[22ch]" data-split="load">{title}</h1>
      <p class="lead mt-8 max-w-3xl" data-hero-item>{summary}</p>
      {
        pdf && (
          <div class="mt-10 flex flex-wrap gap-3" data-hero-item>
            <a href={pdf} class="btn btn-primary" download>
              {t('common.download')} <span aria-hidden="true">↓</span>
            </a>
          </div>
        )
      }
    </header>

    {
      hasBody && (
        <div class="container-x pb-16">
          <div class="prose-legem">
            <Content />
          </div>
        </div>
      )
    }

  </article>

  {
    related.length > 0 && (
      <section class="container-x pb-20">
        <p class="eyebrow">{t(`pubs.${category}` as const)}</p>
        <div class="mt-8 border-b border-line">
          {related.map((p) => (
            <PublicationRow pub={p} />
          ))}
        </div>
      </section>
    )
  }

  <CallToAction lang={lang} />
  <div class="h-10 md:h-16"></div>
</Base>
