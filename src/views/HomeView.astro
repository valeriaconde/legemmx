---
import Base from '@/layouts/Base.astro';
import Media from '@/components/Media.astro';
import CallToAction from '@/components/CallToAction.astro';
import { useTranslations } from '@/i18n/ui';
import { path, areaPath, type Lang } from '@/i18n/routes';
import { practiceAreas } from '@/data/practice-areas';
import { attorneys } from '@/data/team';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const altLang: Lang = lang === 'es' ? 'en' : 'es';

const stats = [
  { value: 300, prefix: '+', label: t('home.stats.clients') },
  { value: 150, prefix: '', label: t('home.stats.countries') },
  { value: 22, prefix: '', label: t('home.stats.specialties') },
  { value: 40, prefix: '', label: t('home.stats.lawyers') },
];
const why = [1, 2, 3, 4].map((n) => ({
  title: t(`home.why.${n}.title` as any),
  body: t(`home.why.${n}.body` as any),
}));
const industries = t('home.industries.list').split(',');
const quote = '“We are what we repeatedly do. Excellence, then, is not an act, but a habit.”';
---

<Base lang={lang} altPath={path('home', altLang)} darkHero>
  <!-- ============ HERO ============ -->
  <section data-header-dark class="on-dark relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink text-paper">
    <div class="absolute inset-0 -z-10">
      <!-- TODO: foto o video del hero. Sugerencia: detalle arquitectónico / sala de juntas en tonos fríos. -->
      <Media
        src="/images/hero1.jpeg"
        alt=""
        hint={lang === 'es' ? 'Foto hero · arquitectura / sala de juntas' : 'Hero photo · architecture / boardroom'}
        ratio="auto"
        tone="dark"
        class="h-full w-full"
        eager
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30"></div>
    </div>

    <div class="container-x flex flex-1 flex-col justify-end pt-36 pb-10 md:pb-14">
      <p class="eyebrow !text-paper/60" data-hero-item>{t('home.hero.eyebrow')}</p>
      <h1 class="display-xl mt-6 max-w-[13ch]" data-split="load">{t('home.hero.title')}</h1>

      <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-12 lg:items-center">
        <p class="max-w-xl text-lg leading-relaxed text-paper/75 lg:col-span-6" data-hero-item>
          {t('home.hero.lead')}
        </p>
      </div>

      <div
        class="hairline mono mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t pt-5 text-paper/55"
        data-hero-item
      >
        <span>{t('home.hero.meta1')}</span>
        <span class="hidden md:inline">↓ Scroll</span>
      </div>
    </div>
  </section>

  <!-- ============ CIFRAS ============ -->
  <section class="hairline border-b">
    <div class="container-x grid grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        stats.map((s, i) => (
          <div
            class:list={[
              'hairline py-10 md:py-14',
              i % 2 === 1 && 'border-l pl-6 md:pl-10',
              i === 2 && 'border-t lg:border-t-0 lg:border-l lg:pl-10',
              i === 3 && 'border-t lg:border-t-0',
            ]}
          >
            <p class="font-display text-6xl leading-none md:text-7xl">
              {s.prefix}<span data-count={s.value}>{s.value}</span>
            </p>
            <p class="mono mt-4 text-muted">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ LA FIRMA ============ -->
  <section class="container-x pt-24 pb-10 md:pt-36 md:pb-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <p class="eyebrow" data-reveal>01 — {t('home.intro.label')}</p>
      </div>
      <div class="lg:col-span-9">
        <p class="display-md max-w-[22ch]" data-words>{t('home.intro.statement')}</p>
        <div class="mt-14 grid gap-10 md:grid-cols-2 md:items-end">
          <p class="text-lg text-muted" data-reveal>{t('home.intro.body')}</p>
          <div class="md:text-right" data-reveal>
            <a href={path('about', lang)} class="btn btn-outline">
              {t('home.intro.cta')} <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ÁREAS DE PRÁCTICA ============ -->
  <!-- En escritorio la sección queda fija y las 4 tarjetas suben al hacer scroll (ver pinnedAreas en motion.ts) -->
  <section
    id="areas"
    data-areas-pin
    data-header-dark
    class="on-dark overflow-hidden bg-ink py-24 text-paper md:py-32 lg:flex lg:min-h-[100svh] lg:flex-col lg:justify-center lg:pt-36 lg:pb-16"
  >
    <div class="container-x">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow !text-paper/60" data-reveal>02 — {t('home.areas.label')}</p>
          <h2 class="display-lg mt-6 max-w-[20ch]" data-split>{t('home.areas.title')}</h2>
        </div>
        <div class="lg:col-span-4 lg:text-right" data-reveal>
          <a href={path('areas', lang)} class="btn btn-outline">
            {t('nav.allAreas')} <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-4">
        {
          practiceAreas.map((a, i) => (
            <a
              href={areaPath(a.slug[lang], lang)}
              data-area-card
              class="group hairline relative flex flex-col gap-8 rounded-xl border bg-ink-2/60 p-6 transition-colors duration-500 hover:bg-brand-deep"
            >
              <span class="mono text-paper/45">0{i + 1}</span>
              <div>
                <h3 class="display-sm">{a.name[lang]}</h3>
                <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-paper/60">{a.summary[lang]}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ POR QUÉ LEGEM ============ -->
  <section class="container-x pt-24 pb-10 md:pt-36 md:pb-16">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <p class="eyebrow" data-reveal>03 — {t('home.why.label')}</p>
          <h2 class="display-lg mt-6" data-split>{t('home.why.title')}</h2>
          <Media
            src="/images/distingue-premios.jpg"
            alt={lang === 'es' ? 'Equipo de Legem en reunión' : 'Legem team in a meeting'}
            hint={lang === 'es' ? 'Foto · equipo en reunión con cliente' : 'Photo · team meeting a client'}
            ratio="4/3"
            class="mt-10 hidden rounded-2xl lg:block"
            parallax
          />
        </div>
      </div>
      <ol class="lg:col-span-7 lg:col-start-6">
        {
          why.map((w, i) => (
            <li class="hairline grid grid-cols-[3.5rem_1fr] gap-4 border-t py-10 md:py-12" data-reveal>
              <span class="font-display text-3xl text-brand">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="display-sm">{w.title}</h3>
                <p class="mt-4 max-w-lg text-muted">{w.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ SECTORES ============ -->
  <section class="hairline border-y bg-paper-2 py-16 md:py-20">
    <div class="container-x grid gap-6 lg:grid-cols-12 lg:items-end">
      <p class="eyebrow lg:col-span-3" data-reveal>04 — {t('home.industries.label')}</p>
      <p class="display-sm max-w-3xl lg:col-span-9" data-reveal>{t('home.industries.title')}</p>
    </div>
    <div class="marquee mt-12" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {industries.map((name) => (
              <span class="flex items-center gap-10 pr-10 font-display text-5xl whitespace-nowrap md:text-7xl">
                {name}
                <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
    <p class="sr-only">{industries.join(', ')}</p>
  </section>

  <!-- ============ EQUIPO ============ -->
  <section class="container-x pt-24 pb-10 md:pt-36 md:pb-16">
    <div class="grid gap-10 overflow-hidden rounded-[28px] bg-paper-2 md:grid-cols-2">
      <div class="flex flex-col justify-between gap-10 p-8 md:p-14">
        <div>
          <p class="eyebrow" data-reveal>05 — {t('home.team.label')}</p>
          <h2 class="display-md mt-6 max-w-[16ch]" data-split>{t('home.team.title')}</h2>
          <p class="mt-6 max-w-md text-muted" data-reveal>{t('home.team.body')}</p>
        </div>
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <p>
            <span class="font-display text-7xl leading-none" data-count={40}>40</span>
            <span class="mono ml-2 text-muted">{t('home.stats.lawyers')}</span>
          </p>
          <a href={path('team', lang)} class="btn btn-primary">
            {t('home.team.cta')} <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <Media
        src="/images/equipo7.png"
        alt={lang === 'es' ? 'Abogados de Legem' : 'Legem attorneys'}
        hint={lang === 'es' ? 'Foto grupal del equipo' : 'Team group photo'}
        ratio="5/4"
        tone="brand"
        class="h-full min-h-[320px]"
        position="72% 50%"
        zoom={1.06}
        parallaxAmount={0.05}
        parallax
      />
    </div>
  </section>

  <!-- ============ CITA ============ -->
  <section class="container-x py-20 text-center md:py-32">
    <blockquote>
      <p class="display-lg mx-auto max-w-[24ch]" data-words lang="en">{quote}</p>
      <footer class="mono mt-10 text-muted" data-reveal>— Aristotle</footer>
    </blockquote>
  </section>

  <!-- ============ CONTACTO ============ -->
  <CallToAction lang={lang} />
  <div class="h-10 md:h-16"></div>
</Base>
