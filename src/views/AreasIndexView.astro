---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CallToAction from '@/components/CallToAction.astro';
import { useTranslations } from '@/i18n/ui';
import { path, type Lang } from '@/i18n/routes';
import { practiceAreas } from '@/data/practice-areas';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const altLang: Lang = lang === 'es' ? 'en' : 'es';
---

<Base lang={lang} title={t('areas.label')} altPath={path('areas', altLang)}>
  <PageHero label={t('areas.label')} title={t('areas.title')} lead={t('areas.lead')} />

  <section class="pb-24 md:pb-32">
    <div class="container-x">
      <div
        class="grid gap-px overflow-hidden rounded-2xl border border-[#d9d3c6] bg-[#d9d3c6] md:grid-cols-2 xl:grid-cols-4"
        data-reveal-stagger
      >
        {
          practiceAreas.map((a) => (
            <article
              id={a.slug[lang]}
              class="row-span-2 grid scroll-mt-32 grid-rows-subgrid gap-0 bg-paper p-8 md:p-10"
            >
              <h2 class="display-sm text-[clamp(2rem,3vw,2.6rem)]">{a.name[lang]}</h2>
              <ul class="mt-6 space-y-2 border-t border-line pt-6 text-[0.95rem] text-muted">
                {a.specialties.map((s) => (
                  <li>{s.name[lang]}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction lang={lang} />
  <div class="h-10 md:h-16"></div>
</Base>
