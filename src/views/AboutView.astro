---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Media from '@/components/Media.astro';
import CallToAction from '@/components/CallToAction.astro';
import { useTranslations } from '@/i18n/ui';
import { path, type Lang } from '@/i18n/routes';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const altLang: Lang = lang === 'es' ? 'en' : 'es';

const body = {
  es: [
    'Legem Attorneys at Law surge con el propósito de apoyar el crecimiento de la inversión extranjera directa y el emprendimiento en México. Integrada por profesionales especializados en diversas disciplinas del Derecho, con oficinas en el norte, bajío, centro y sureste del país, garantizando los más altos estándares éticos y profesionales en la prestación de sus servicios.',
    'Desde nuestros inicios nos hemos enfocado en ofrecer consultoría legal de excelencia, razón por la cual firmas de consultoría internacional como Forvis Mazars, Plante & Moran, Grant Thornton, Moss Adams y Baker Tilly, entre otras, nos han seleccionado para apoyarlas conjuntamente en la estructuración de negocios en México y en la protección de sus intereses en el país. La inmediatez y la excelencia en nuestros servicios nos distinguen.',
    'Pertenecemos a diversas alianzas internacionales de firmas de consultoría de negocios y somos miembro exclusivo en México para Inversión Extranjera Directa de IR Global, una alianza estratégica con sede en Londres que ofrece servicios legales, contables y financieros en 155 jurisdicciones alrededor del mundo. Desde 2019 hemos sido reconocidos por diversas organizaciones que nos posicionan como firma legal líder en Inversión Extranjera Directa en México.',
    'Nuestro compromiso es ayudar al crecimiento de nuestros clientes mediante la prestación de servicios legales oportunos orientados a proteger sus intereses personales, económicos y comerciales.',
  ],
  en: [
    'Legem Attorneys at Law was created to support the growth of foreign direct investment and entrepreneurship in Mexico. Made up of professionals who specialize in a range of legal disciplines, with offices in northern, Bajío, central and southeast Mexico, the firm guarantees the highest ethical and professional standards in the delivery of its services.',
    'Since our beginnings we have focused on delivering excellent legal consulting, which is why international consulting firms such as Forvis Mazars, Plante & Moran, Grant Thornton, Moss Adams and Baker Tilly, among others, have selected us to work alongside them in structuring businesses in Mexico and protecting their interests in the country. Responsiveness and excellence in our services set us apart.',
    'We belong to several international alliances of business consulting firms and are the exclusive Mexican member for Foreign Direct Investment of IR Global, a London-based strategic alliance offering legal, accounting and financial services across 155 jurisdictions worldwide. Since 2019 we have been recognized by various organizations that position us as a leading law firm in Foreign Direct Investment in Mexico.',
    'Our commitment is to help our clients grow by providing timely legal services aimed at protecting their personal, economic and commercial interests.',
  ],
}[lang];

const values = [1, 2, 3].map((n) => ({
  title: t(`about.values.${n}.title` as any),
  body: t(`about.values.${n}.body` as any),
}));
---

<Base lang={lang} title={t('about.label')} altPath={path('about', altLang)}>
  <PageHero title={t('about.title')} />

  <section class="container-x">
    <Media
      src="/images/firmafinal.jpeg"
      alt={lang === 'es' ? 'Equipo caminando en un edificio de oficinas' : 'Team walking through an office building'}
      hint={lang === 'es' ? 'Foto panorámica · oficinas / equipo' : 'Wide photo · offices / team'}
      ratio="21/9"
      class="rounded-[28px]"
      parallax
      eager
    />
  </section>

  <section class="container-x py-24 md:py-32">
    <div class="md:px-10 lg:px-20 xl:px-28">
      <p class="display-md max-w-[22ch]" data-words>{t('home.intro.statement')}</p>
      <div class="mt-12 text-lg text-muted md:columns-2 md:gap-12" data-reveal-stagger>
        {body.map((p) => <p class="mb-8 break-inside-avoid last:mb-0">{p}</p>)}
      </div>
    </div>
  </section>

  <section data-header-dark class="on-dark bg-ink py-24 text-paper md:py-32">
    <div class="container-x">
      <div class="grid gap-px overflow-hidden rounded-2xl bg-paper/10 md:grid-cols-3" data-reveal-stagger>
        {
          values.map((v) => (
            <div class="bg-ink p-8 md:p-10">
              <h2 class="display-sm">{v.title}</h2>
              <p class="mt-4 text-paper/65">{v.body}</p>
            </div>
          ))
        }
      </div>
      <blockquote class="mt-24 text-center">
        <p class="display-md mx-auto max-w-[26ch]" data-words>
          {
            lang === 'es'
              ? '“Somos lo que constantemente hacemos. La excelencia, entonces, no es un acto, sino un hábito.”'
              : '“We are what we repeatedly do. Excellence, then, is not an act, but a habit.”'
          }
        </p>
        <footer class="mono mt-8 text-paper/50">— {lang === 'es' ? 'Aristóteles' : 'Aristotle'}</footer>
      </blockquote>
    </div>
  </section>

  <section class="bg-paper-2 py-24 md:py-32">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="display-md max-w-[16ch]" data-split>{t('about.offices.title')}</h2>
        <p class="mt-6 max-w-md text-muted" data-reveal>{t('about.lead')}</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7" data-reveal-stagger>
        {
          site.offices.map((o) => (
            <li class="relative overflow-hidden rounded-2xl">
              <Media
                src={o.image}
                alt={`${o.region[lang]}`}
                hint=""
                ratio="4/3"
                tone="dark"
                position={'position' in o ? o.position : undefined}
              />
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"
                aria-hidden="true"
              />
              <div class="absolute bottom-0 left-0 p-6 text-paper">
                <p class="display-sm">{o.region[lang]}</p>
                {o.city && <p class="mt-1 text-paper/75">{o.city}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CallToAction lang={lang} />
  <div class="h-10 md:h-16"></div>
</Base>
