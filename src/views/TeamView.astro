---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CallToAction from '@/components/CallToAction.astro';
import { useTranslations } from '@/i18n/ui';
import { path, type Lang } from '@/i18n/routes';
import PersonCard from '@/components/PersonCard.astro';
import { attorneys } from '@/data/team';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const altLang: Lang = lang === 'es' ? 'en' : 'es';

---

<Base lang={lang} title={t('team.label')} altPath={path('team', altLang)}>
  <PageHero label={t('team.label')} title={t('team.title')} lead={t('team.lead')} />

  <section class="container-x pb-24">
    <ul id="team-grid" class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {attorneys.map((p) => <PersonCard person={p} lang={lang} />)}
    </ul>

    <div class="hairline mt-24 grid gap-6 border-t pt-10 lg:grid-cols-12" data-reveal>
      <h2 class="font-display text-3xl leading-tight lg:col-span-5">{t('team.note.title')}</h2>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-muted">{t('team.note.body')}</p>
        <a href={path('contact', lang)} class="link-line mt-4 inline-block text-brand">{t('team.note.cta')}</a>
      </div>
    </div>
  </section>

  <CallToAction lang={lang} />
  <div class="h-10 md:h-16"></div>
</Base>
