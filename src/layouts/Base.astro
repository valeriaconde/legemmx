---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { useTranslations } from '@/i18n/ui';
import type { Lang } from '@/i18n/routes';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta equivalente en el otro idioma (para el selector de idioma y SEO) */
  altPath: string;
  /** true = la cabecera empieza sobre un fondo oscuro */
  darkHero?: boolean;
  noindex?: boolean;
}

const { lang, title, description, altPath, darkHero = false, noindex = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · Legem Attorneys at Law` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, site.url).href;
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altUrl = new URL(altPath, site.url).href;
const esUrl = lang === 'es' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: site.legalName,
  url: site.url,
  email: site.contactEmail,
  areaServed: 'MX',
  availableLanguage: ['es', 'en'],
  knowsAbout: ['Foreign investment', 'Corporate law', 'Litigation', 'Compliance', 'Insurance'],
};
---

<!doctype html>
<html lang={lang === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-MX" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d1624" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Legem Attorneys at Law" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:image" content={new URL('/og-image.png', site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      >{t('nav.skip')}</a
    >
    <Header lang={lang} altPath={altPath} altLang={altLang} darkHero={darkHero} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
