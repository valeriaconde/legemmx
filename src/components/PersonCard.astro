---
import { initials, personSlug, type Person } from '@/data/team';
import { personPath, type Lang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  person: Person;
  lang: Lang;
}
const { person: p, lang } = Astro.props;
const t = useTranslations(lang);
const href = p.bio ? personPath(personSlug(p), lang) : undefined;
const Wrap = href ? 'a' : 'div';
---

<li class="person group" data-groups={p.groups.join(' ')}>
  <Wrap href={href} class="block">
    <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-paper-2">
      {
        p.photo ? (
          <img
            src={p.photo}
            alt={p.name}
            loading="lazy"
            class="h-full w-full object-cover object-top grayscale transition duration-700 group-hover:scale-[1.03]"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center" aria-hidden="true">
            <span class="font-display text-7xl text-ink/15 transition-colors duration-500 group-hover:text-brand/50">
              {initials(p.name)}
            </span>
          </div>
        )
      }
    </div>
    <h2 class="mt-5 text-lg leading-snug font-medium">{p.name}</h2>
    <p class="mt-1 text-muted">{p.role[lang]}</p>
  </Wrap>
  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
    <a href={`mailto:${p.email}`} class="link-line inline-block text-brand">{p.email}</a>
    {
      href && (
        <a href={href} class="link-line text-ink">
          {t('team.bio')} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</li>
