---
import { formatDate, type Publication } from '@/lib/publications';
import { useTranslations } from '@/i18n/ui';

interface Props {
  pub: Publication;
  showCategory?: boolean;
}
const { pub, showCategory = false } = Astro.props;
const t = useTranslations(pub.lang);
const { title, summary, date } = pub.entry.data;
const categoryLabel = t(`pubs.${pub.category}` as const);
---

<article class="group hairline relative border-t">
  <a
    href={pub.url}
    class="grid gap-3 py-8 transition-colors duration-500 md:grid-cols-12 md:gap-8 md:py-10"
  >
    <div class="mono flex gap-3 text-muted md:col-span-3 md:flex-col md:gap-2">
      <time datetime={date.toISOString()}>{formatDate(date, pub.lang)}</time>
      {showCategory && <span class="text-brand">{categoryLabel}</span>}
    </div>
    <div class="md:col-span-8">
      <h3 class="display-sm transition-colors duration-300 group-hover:text-brand">{title}</h3>
      <p class="mt-3 line-clamp-2 max-w-3xl text-muted">{summary}</p>
    </div>
    <div class="hidden items-start justify-end md:col-span-1 md:flex">
      <span
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line transition-all duration-500 group-hover:border-brand group-hover:bg-brand group-hover:text-white"
        aria-hidden="true">→</span
      >
    </div>
  </a>
</article>
