---
/**
 * Logotipo oficial de Legem (fuente: fuentes/imagenes-originales/LEGEM.png, recortado en /public/brand/logo.png).
 * Se pinta con dos máscaras para adaptarse al fondo:
 *   - logo-mark-mask.png: el trazo azul → color de marca (más claro sobre fondos oscuros)
 *   - logo-text-mask.png: "Legem / Attorneys at Law" → currentColor (negro o blanco según el header)
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['logo relative inline-block h-12 select-none', className]} role="img" aria-label="Legem Attorneys at Law">
  <span class="logo-layer logo-mark" aria-hidden="true"></span>
  <span class="logo-layer logo-text" aria-hidden="true"></span>
</span>

<style>
  .logo {
    aspect-ratio: 1001 / 339;
    --logo-mark: #003399;
  }
  :global(.on-dark) .logo,
  :global(.site-header[data-dark='true']) .logo,
  :global(.site-header[data-open='true']) .logo {
    --logo-mark: #6f8ff0;
  }
  .logo-layer {
    position: absolute;
    inset: 0;
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    transition: background-color 0.4s var(--ease-out-expo);
  }
  .logo-mark {
    background-color: var(--logo-mark);
    mask-image: url('/brand/logo-mark-mask.png');
    -webkit-mask-image: url('/brand/logo-mark-mask.png');
  }
  .logo-text {
    background-color: currentColor;
    mask-image: url('/brand/logo-text-mask.png');
    -webkit-mask-image: url('/brand/logo-text-mask.png');
  }
</style>
