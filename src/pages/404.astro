---
import Base from '@/layouts/Base.astro';
---

<Base lang="es" title="404" altPath="/en/" noindex>
  <section class="container-x flex min-h-[80vh] flex-col justify-center pt-32 pb-20">
    <p class="font-display text-[28vw] leading-none text-brand md:text-[16rem]">404</p>
    <div class="mt-6 grid gap-10 md:grid-cols-2">
      <div>
        <h1 class="display-md">Página no encontrada</h1>
        <p class="mt-3 text-muted">La página que busca no existe o fue movida.</p>
        <a href="/" class="btn btn-primary mt-8">Ir al inicio <span class="btn-arrow">→</span></a>
      </div>
      <div lang="en">
        <h2 class="display-md">Page not found</h2>
        <p class="mt-3 text-muted">The page you are looking for doesn’t exist or has moved.</p>
        <a href="/en/" class="btn btn-outline mt-8">Go to homepage <span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>
</Base>
