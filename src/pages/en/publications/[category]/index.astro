---
import CategoryView from '@/views/CategoryView.astro';
import { publicationCategories, type PublicationCategory } from '@/i18n/routes';

export function getStaticPaths() {
  return (Object.keys(publicationCategories) as PublicationCategory[]).map((category) => ({
    params: { category: publicationCategories[category].en },
    props: { category },
  }));
}
const { category } = Astro.props;
---

<CategoryView lang="en" category={category} />
