---
import AreaView from '@/views/AreaView.astro';
import { practiceAreas } from '@/data/practice-areas';

export function getStaticPaths() {
  return practiceAreas.map((area) => ({ params: { slug: area.slug.en }, props: { area } }));
}
const { area } = Astro.props;
---

<AreaView lang="en" area={area} />
